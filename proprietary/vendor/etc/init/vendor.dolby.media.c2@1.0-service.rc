service vendor-dolby-media-c2-hal-1-0 /vendor/bin/hw/vendor.dolby.media.c2@1.0-service
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    writepid /dev/cpuset/foreground/tasks
    wait_for_prop init.svc.dms-hal-2-1 running

# The Dolby decoders reach the DMS through libdeccfg -> libdmshal, so the store
# cannot initialise before the DMS HAL is running. init.svc.* is maintained by
# init itself, so no extra property plumbing is needed. On timeout init carries
# on and the store simply logs a failure - it cannot block boot.